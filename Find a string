def count_substring(string, sub_string):
    count = 0
    # Iterate through the main string from the beginning up to the point 
    # where the substring could still fit entirely.
    for i in range(len(string) - len(sub_string) + 1):
        # Slice the main string to check for the substring at the current position 'i'
        if string[i:i+len(sub_string)] == sub_string:
            count += 1
    return count





