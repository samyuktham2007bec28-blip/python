from collections import OrderedDict
inventory = OrderedDict()
n = int(input())

for _ in range(n):
    data = input().rsplit(' ', 1)
    item_name = data[0]
    price = int(data[1])
    inventory[item_name] = inventory.get(item_name, 0) + price
for item, net_price in inventory.items():
    print(f"{item} {net_price}")
