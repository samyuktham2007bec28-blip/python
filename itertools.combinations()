import itertools

def solve_combinations():
    try:
        s_input, k_input = input().split()
        k = int(k_input)
    except ValueError:
        return
    sorted_s = sorted(s_input)
    for length in range(1, k + 1):
        combs = itertools.combinations(sorted_s, length)
        for comb in combs:
            print("".join(comb))

solve_combinations()
