def print_formatted(number):
    # Determine the width of the binary representation of the maximum number
    width = len(bin(number)[2:])
    
    for i in range(1, number + 1):
        # Format decimal, octal, uppercase hex, and binary
        # 'rjust' is used for space padding to match the width
        print(f"{str(i).rjust(width)} {oct(i)[2:].rjust(width)} "
              f"{hex(i)[2:].upper().rjust(width)} {bin(i)[2:].rjust(width)}")

