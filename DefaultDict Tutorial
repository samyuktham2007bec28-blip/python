# Enter your code here. Read input from STDIN. Print output to STDOUT
from collections import defaultdict

# Read n and m
n_m = list(map(int, input().split()))
n = n_m[0]
m = n_m[1]

# Create a defaultdict with a list as the default factory
# This will automatically create an empty list for any new key accessed
d = defaultdict(list)

# Read words for Group A and store their 1-based indices
for i in range(n):
    word = input()
    d[word].append(i + 1)

# Read words for Group B and print their indices from Group A, or -1
for i in range(m):
    word = input()
    if word in d:
        # Print the indices, separated by spaces
        print(" ".join(map(str, d[word])))
    else:
        print("-1")
